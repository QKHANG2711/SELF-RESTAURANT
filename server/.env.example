# Cấu hình môi trường SELF RESTAURANT Backend
PORT=5000
NODE_ENV=development

# Database connection:
# SQLite (Local Dev): DATABASE_URL="file:./dev.db"
# MySQL (Production/Local MySQL): DATABASE_URL="mysql://root:password@localhost:3306/self_restaurant"
DATABASE_URL="file:./dev.db"

# JWT Auth Secret
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=24h

# Frontend Origin for CORS
CLIENT_URL=http://localhost:5173
